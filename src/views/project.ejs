<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>
        <p>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                year: 'numeric' }) %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a></p>
    </main>
    <%- include('partials/footer') %>